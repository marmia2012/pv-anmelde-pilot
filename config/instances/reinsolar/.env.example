# Instanz reinsolar – Vorlage für die Railway-Variablen (Staging und Produktion je eigener Service).
# Werte NIE committen. Lokal: als .env kopieren (wird von git ignoriert) oder appsettings.Local.json nutzen.
# Doppelter Unterstrich (__) entspricht der Verschachtelung in appsettings, z. B. Reonic__ApiKey → Reonic:ApiKey.

# --- Laufzeit -----------------------------------------------------------------
# Staging | Production
ASPNETCORE_ENVIRONMENT=Staging
Instance__Name=reinsolar
Instance__ConfigFile=/app/config/instances/reinsolar/instance.json

# --- Datenbank ------------------------------------------------------------------
# Railway: Referenzvariablen des Postgres-Service verwenden, z. B.
# Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};Database=${{Postgres.PGDATABASE}};Username=${{Postgres.PGUSER}};Password=${{Postgres.PGPASSWORD}}
ConnectionStrings__Autopilot=

# --- Einreichung -----------------------------------------------------------------
# DryRun (Default, nichts wird versendet) | Review (Freigabe in HubSpot nötig) | Live
Submission__Mode=DryRun
# Nur Staging-Demo (appsettings.Staging.json setzt true): nach DryRun weiterlaufen. Nur mit Mode=DryRun erlaubt –
# wer Staging auf Review/Live stellt, muss hier false setzen. In Produktion immer false.
# Submission__ContinueAfterDryRun=false

# --- Watchdog (optional, Defaults siehe README) ---------------------------------------
# Watchdog__Schedule=0 7 * * 1-5

# --- Betrieb -----------------------------------------------------------------------
# Header X-Admin-Key für /admin/*; leer = Admin-Endpunkte gesperrt. Langer Zufallswert.
Admin__ApiKey=

# --- HubSpot -------------------------------------------------------------------------
# Private App Token
HubSpot__AccessToken=
# Client-Secret der App, für die Webhook-Signatur v3
HubSpot__ClientSecret=
# Schreibzugriffe nach HubSpot (Aufgaben, Audit-Notizen, Dateien + Ablage-Notiz, Status-PATCH am Deal).
# Default false = nichts wird geschrieben, nur Debug-Log. Erst nach Freigabe durch Martin je Umgebung auf true setzen;
# der Token braucht dann zusätzlich Schreib-Scopes (Deals, Aufgaben, Notizen, Dateien).
# HubSpot__WriteEnabled=false

# --- Reonic ----------------------------------------------------------------------------
# v3-Key rnc_v3_… mit Leserechten auf projects, checklists, components, files
Reonic__ApiKey=

# --- MaStR -------------------------------------------------------------------------------
# Default ist das Testsystem. Produktion erst zum Go-live umstellen:
# Mastr__PortalUrl=https://www.marktstammdatenregister.de/
Mastr__PortalUrl=https://test.marktstammdatenregister.de/

# --- Noch nicht verwendet (Adapter folgen) ------------------------------------------------
# Microsoft Graph: SharePoint-Datenblätter und Postfach anschlussplanung@
# Graph__TenantId=
# Graph__ClientId=
# Graph__ClientSecret=
# Graph__Mailbox=
# OpenAI (Mails klassifizieren, Datenblätter auslesen)
# OpenAI__ApiKey=
# Alarm-Mails bei technischen Fehlern
# Alerts__Recipient=
